---
import Base from '../layouts/Base.astro';
import Brand from '../components/Brand.astro';
import Footer from '../components/Footer.astro';
import Shot from '../components/Shot.astro';
import StoreBadge from '../components/StoreBadge.astro';
import icon from '../assets/icon.png';
import iconDark from '../assets/icon-dark.png';
import tileGauge from '../assets/tile-gauge.png';
import tileBar from '../assets/tile-bar.png';
import timer from '../assets/timer.png';
import timerDark from '../assets/timer-dark.png';
import history from '../assets/history.png';
import historyDark from '../assets/history-dark.png';
import phase from '../assets/phase.png';
import phaseDark from '../assets/phase-dark.png';
import stats from '../assets/stats.png';
import statsDark from '../assets/stats-dark.png';
import notifications from '../assets/notifications.png';
import notificationsDark from '../assets/notifications-dark.png';
import night from '../assets/night.png';
import fullphase from '../assets/fullphase.png';
import pop from '../assets/pop.png';
import home from '../assets/home.png';
import lock from '../assets/lock.png';
import lockWidget from '../assets/lock-widget.png';

const title = 'Faster: Intermittent Fasting Timer for iPhone';
const description = 'Faster is a simple, private intermittent fasting timer for iPhone. Follow your fast through digesting, fat burning and ketosis, with widgets, insights and no account. Supports 16:8, 18:6, 20:4 and OMAD.';
const social = 'Follow your fast phase by phase, from digesting to fat burning and ketosis. Simple, private, no account.';
const base = import.meta.env.BASE_URL;
const absolute = (path: string) => new URL(path, Astro.site).href;
const og = absolute(`${base}images/og.png`);

const ld = JSON.parse(`{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://robinbaral.github.io/faster/#website",
      "url": "https://robinbaral.github.io/faster/",
      "name": "Faster",
      "inLanguage": "en"
    },
    {
      "@type": "MobileApplication",
      "@id": "https://robinbaral.github.io/faster/#app",
      "name": "Faster: Intermittent Fasting",
      "alternateName": "Faster",
      "description": "A simple, private intermittent fasting timer that shows what your body is doing as your fast goes on, from digesting to fat burning and ketosis.",
      "operatingSystem": "iOS 17.0 or later",
      "applicationCategory": "HealthApplication",
      "applicationSubCategory": "Intermittent fasting tracker",
      "image": "https://robinbaral.github.io/faster/images/icon.png",
      "screenshot": [
        "https://robinbaral.github.io/faster/images/timer.png",
        "https://robinbaral.github.io/faster/images/phase.png",
        "https://robinbaral.github.io/faster/images/stats.png",
        "https://robinbaral.github.io/faster/images/history.png"
      ],
      "featureList": [
        "Fasting timer with five phases: digesting, settling, fat burning, ketosis and deep fast",
        "Goals for 12:12, 14:10, 16:8, 18:6, 20:4, one meal a day and custom fasts up to 72 hours",
        "Lock Screen and Home Screen widgets",
        "Stats, streaks, trends and plain-language insights",
        "Editable fasting history",
        "Reminders for the eating window, each phase and the goal",
        "Five themes with matching app icons and widgets",
        "No account, no ads, no tracking"
      ],
      "inLanguage": ["en", "de", "es", "fr", "pt-BR", "ja"],
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD", "availability": "https://schema.org/InStock" },
      "author": { "@type": "Person", "name": "Robin" },
      "url": "https://robinbaral.github.io/faster/",
      "downloadUrl": "https://apps.apple.com/app/id6829356882",
      "installUrl": "https://apps.apple.com/app/id6829356882",
      "isAccessibleForFree": true
    },
    {
      "@type": "FAQPage",
      "@id": "https://robinbaral.github.io/faster/#faq",
      "mainEntity": [
        { "@type": "Question", "name": "What is the best app to track intermittent fasting on iPhone?", "acceptedAnswer": { "@type": "Answer", "text": "Faster is a simple intermittent fasting tracker for iPhone. Start a fast with one tap, watch it move through each fasting phase, and keep an eye on it from widgets on your Lock Screen and Home Screen. It's free, needs no account and shows no ads." } },
        { "@type": "Question", "name": "Which fasting schedules does Faster support?", "acceptedAnswer": { "@type": "Answer", "text": "Faster has ready-made goals for 12:12, 14:10, 16:8, 18:6, 20:4 and one meal a day (OMAD, 23:1), and you can set any custom goal from 8 to 72 hours, including 24-hour and longer fasts." } },
        { "@type": "Question", "name": "What are the phases of a fast?", "acceptedAnswer": { "@type": "Answer", "text": "Faster follows five phases: digesting, settling, fat burning, ketosis and deep fast. The dial shows which one you're in, and you can tap any phase to read what's happening in your body. Timings are a general guide and vary from person to person." } },
        { "@type": "Question", "name": "When does fat burning start during a fast?", "acceptedAnswer": { "@type": "Answer", "text": "For many people, the body leans more on stored fat after roughly 12 hours without food, once most glycogen has been used. Faster marks this as the fat burning phase on its dial. It's a rough guide, not a medical measurement." } },
        { "@type": "Question", "name": "Is Faster free?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. The timer, phases, widgets, reminders, stats and history are all free, with no subscription. An optional one-time purchase unlocks four extra themes with matching app icons and widgets." } },
        { "@type": "Question", "name": "Does Faster have widgets?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Faster has Lock Screen and Home Screen widgets that keep counting without opening the app. Between fasts they count down to your next fast and fill up as your eating window passes." } },
        { "@type": "Question", "name": "Does Faster need an account or collect my data?", "acceptedAnswer": { "@type": "Answer", "text": "No. There's no account, no analytics and no tracking. Your fasts are stored only on your iPhone and are never sent to the developer." } },
        { "@type": "Question", "name": "Can I fix a fast if I forgot to start or end it?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. You can move the start time of a running fast, adjust both times when you end one, and edit or delete past fasts in History. Faster can also remind you if you forget to end a fast." } },
        { "@type": "Question", "name": "Which languages is Faster available in?", "acceptedAnswer": { "@type": "Answer", "text": "Faster is available in English, German, Spanish, French, Brazilian Portuguese and Japanese." } },
        { "@type": "Question", "name": "Who makes Faster?", "acceptedAnswer": { "@type": "Answer", "text": "Faster is made by Robin, an independent developer. Questions and ideas are welcome at fasterfastingapp@proton.me." } }
      ]
    }
  ]
}`);
// The app's icon and screenshots point at the files the build emits.
const app = ld['@graph'].find((node: { '@type': string }) => node['@type'] === 'MobileApplication');
app.image = absolute(icon.src);
app.screenshot = [timer, phase, stats, history].map((image) => absolute(image.src));

// Each `sizes` mirrors the width the stylesheet gives that image.
const phoneSizes = 'min(330px, 74vw)';
const tileSizes = 'clamp(39px, 7.06vw, 95px)';
---
<Base title={title} description={description}>
<Fragment slot="head">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Faster">
<meta property="og:title" content={title}>
<meta property="og:description" content={social}>
<meta property="og:image" content={og}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:url" content={absolute(base)}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={social}>
<meta name="twitter:image" content={og}>
<meta name="apple-itunes-app" content="app-id=6829356882">
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
</Fragment>

<header class="site-header">
  <div class="wrap">
    <Brand />
    <nav>
      <a href="#features">Features</a>
      <a href="#privacy">Privacy</a>
      <a href="#faq">FAQ</a>
    </nav>
    <StoreBadge small />
  </div>
</header>

<main>
  <section class="hero">
    <div class="wrap">
      <h1>
        Your <span class="tile"><Shot src={icon} dark={iconDark} widths={[96, 192]} sizes={tileSizes} loading="eager" /></span> fast,<br>
        phase <span class="tile"><Shot src={tileGauge} widths={[96, 192]} sizes={tileSizes} loading="eager" /></span> by<br>
        phase <span class="tile inset"><Shot src={tileBar} widths={[96, 192]} sizes={tileSizes} loading="eager" /></span>
      </h1>
      <p class="lede">A simple, private intermittent fasting timer that shows what your body is doing, from digesting to fat burning and ketosis.</p>
      <div class="cta">
        <StoreBadge />
        <span class="note">Free · No account · No ads</span>
      </div>
      <Shot class="hero-phone phone" src={timer} dark={timerDark} widths={[330, 620]} sizes={phoneSizes} loading="eager" fetchpriority="high" alt="Faster on iPhone: a fast at 14 hours in the fat burning phase, with 1 hour 53 minutes to its 16-hour goal." />
    </div>
  </section>

  <div class="wrap features" id="features">
    <section class="feature">
      <div class="feature-text">
        <h2>Pick a goal. Keep every fast.</h2>
        <p>Start gently or go further, then look back at each fast: how long it ran and whether you reached your goal. Forgot to tap start or end? Fix the times afterwards.</p>
        <div class="chips" aria-label="Fasting goals">
          <span class="chip"><b>12:12</b>Gentle start</span>
          <span class="chip"><b>14:10</b>A step further</span>
          <span class="chip"><b>16:8</b>Everyday rhythm</span>
          <span class="chip"><b>18:6</b>Longer fast</span>
          <span class="chip"><b>20:4</b>Short eating window</span>
          <span class="chip"><b>23:1</b>One meal a day</span>
          <span class="chip">Custom, up to 72h</span>
        </div>
      </div>
      <div class="feature-media"><Shot class="phone" src={history} dark={historyDark} widths={[300, 620]} sizes={phoneSizes} loading="lazy" alt="Faster's history: a list of fasts with their times, durations and whether each reached its goal." /></div>
    </section>

    <section class="feature flip">
      <div class="feature-text">
        <h2>See what's going on inside.</h2>
        <p>Your fast moves through five phases: digesting, settling, fat burning, ketosis and deep fast. Tap any of them to read what your body is doing right now.</p>
      </div>
      <div class="feature-media"><Shot class="phone" src={phase} dark={phaseDark} widths={[300, 620]} sizes={phoneSizes} loading="lazy" alt="Faster's phase sheet for Settling: blood sugar levels out and insulin drops, with time remaining in the phase." /></div>
    </section>

    <section class="feature">
      <div class="feature-text">
        <h2>Make. It. Pop.</h2>
        <p>Pick from five themes, each with a matching app icon and widgets. The app icon even shows your fasting goal. Default is free; one purchase unlocks the rest.</p>
      </div>
      <div class="feature-media">
        <div class="trio">
          <Shot class="phone" src={night} widths={[210, 420]} sizes="min(210px, 30vw)" loading="lazy" alt="Faster in the Night theme: cool blue and violet on dark." />
          <Shot class="phone" src={fullphase} widths={[210, 420]} sizes="min(210px, 30vw)" loading="lazy" alt="Faster in the Full Phase theme: the whole screen in the current phase's colour." />
          <Shot class="phone" src={pop} widths={[210, 420]} sizes="min(210px, 30vw)" loading="lazy" alt="Faster in the Pop theme: flat, playful colour blocks." />
        </div>
      </div>
    </section>

    <section class="feature flip">
      <div class="feature-text">
        <h2>On your Lock Screen and Home Screen.</h2>
        <p>Widgets keep counting without opening the app. Between fasts they count down to the next one and fill up as your eating window goes by.</p>
      </div>
      <div class="feature-media">
        <div class="pair">
          <Shot class="phone" src={home} widths={[250, 500]} sizes="min(250px, 42vw)" loading="lazy" alt="An iPhone Home Screen with Faster's widgets in different themes." />
          <div class="phone lock">
            <Shot src={lock} widths={[250, 500]} sizes="min(250px, 42vw)" loading="lazy" />
            <Shot class="lock-widget" src={lockWidget} widths={[320, 640]} sizes="min(320px, 54vw)" loading="lazy" alt="Faster's Lock Screen widgets, magnified: the fat burning phase with its timer and goal, and a ring showing 14 hours." />
          </div>
        </div>
      </div>
    </section>

    <section class="feature">
      <div class="feature-text">
        <h2>Your progress at a glance.</h2>
        <p>See your streak, how often you reach your goal and the trend of your fasts. Insights explain in plain words what's changing, like fasts getting longer or start times becoming more regular.</p>
      </div>
      <div class="feature-media"><Shot class="phone" src={stats} dark={statsDark} widths={[300, 620]} sizes={phoneSizes} loading="lazy" alt="Faster's stats: an insight about time spent in fat burning, the last 14 days of fasts and a trend." /></div>
    </section>

    <section class="feature flip">
      <div class="feature-text">
        <h2>Notifications, your way.</h2>
        <p>Let Faster stay out of your way with a single nudge at your goal, or have it cheer you on: halfway there, one hour to go. Want to know what's happening? Hear when your fast moves into each new phase. Every notification switches on or off on its own.</p>
      </div>
      <div class="feature-media"><Shot class="phone" src={notifications} dark={notificationsDark} widths={[300, 620]} sizes={phoneSizes} loading="lazy" alt="Faster's notification settings: reminders around the eating window and during a fast, like a new phase, halfway there and goal reached, each switched on or off." /></div>
    </section>
  </div>

  <section class="band" id="privacy">
    <div class="wrap">
      <h2>Your fasts stay on your iPhone.</h2>
      <div class="points">
        <div class="point">
          <svg viewBox="0 0 40 40" aria-hidden="true"><path fill-rule="evenodd" d="M12 16v-4a8 8 0 0 1 16 0v4h1a5 5 0 0 1 5 5v12a5 5 0 0 1-5 5H11a5 5 0 0 1-5-5V21a5 5 0 0 1 5-5h1zm4 0h8v-4a4 4 0 0 0-8 0v4zm4 7a3 3 0 0 0-1.5 5.6V31a1.5 1.5 0 0 0 3 0v-2.4A3 3 0 0 0 20 23z"/></svg>
          <h3>No account</h3>
          <p>Open the app and start fasting. There's nothing to sign up for.</p>
        </div>
        <div class="point">
          <svg viewBox="0 0 40 40" aria-hidden="true"><path fill-rule="evenodd" d="M20 3l14 5v10c0 9.5-6 16.6-14 19C12 34.6 6 27.5 6 18V8l14-5zm6.4 12.6a1.8 1.8 0 0 0-2.5 0L18 21.5l-2.9-2.9a1.8 1.8 0 1 0-2.5 2.5l4.1 4.1a1.8 1.8 0 0 0 2.6 0l7.1-7.1a1.8 1.8 0 0 0 0-2.5z"/></svg>
          <h3>No ads, no tracking</h3>
          <p>No analytics, no advertising and nothing sent to me. Read the <a href="privacy/">privacy policy</a>.</p>
        </div>
        <div class="point">
          <svg viewBox="0 0 40 40" aria-hidden="true"><path d="M20 3a2.5 2.5 0 0 1 2.5 2.5v.8A11 11 0 0 1 31 17v6.5l3 4.2a1.8 1.8 0 0 1-1.5 2.8h-25A1.8 1.8 0 0 1 6 27.7l3-4.2V17a11 11 0 0 1 8.5-10.7v-.8A2.5 2.5 0 0 1 20 3zm-4.5 30h9a4.5 4.5 0 0 1-9 0z"/></svg>
          <h3>Reminders on your terms</h3>
          <p>A nudge when your eating window closes, at each phase and at your goal, all scheduled on your device.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="faq" id="faq">
    <div class="wrap">
      <h2>Questions about intermittent fasting with Faster</h2>
      <details><summary>What is the best app to track intermittent fasting on iPhone?</summary><p>Faster is a simple intermittent fasting tracker for iPhone. Start a fast with one tap, watch it move through each fasting phase, and keep an eye on it from widgets on your Lock Screen and Home Screen. It's free, needs no account and shows no ads.</p></details>
      <details><summary>Which fasting schedules does Faster support?</summary><p>Faster has ready-made goals for 12:12, 14:10, 16:8, 18:6, 20:4 and one meal a day (OMAD, 23:1), and you can set any custom goal from 8 to 72 hours, including 24-hour and longer fasts.</p></details>
      <details><summary>What are the phases of a fast?</summary><p>Faster follows five phases: digesting, settling, fat burning, ketosis and deep fast. The dial shows which one you're in, and you can tap any phase to read what's happening in your body. Timings are a general guide and vary from person to person.</p></details>
      <details><summary>When does fat burning start during a fast?</summary><p>For many people, the body leans more on stored fat after roughly 12 hours without food, once most glycogen has been used. Faster marks this as the fat burning phase on its dial. It's a rough guide, not a medical measurement.</p></details>
      <details><summary>Is Faster free?</summary><p>Yes. The timer, phases, widgets, reminders, stats and history are all free, with no subscription. An optional one-time purchase unlocks four extra themes with matching app icons and widgets.</p></details>
      <details><summary>Does Faster have widgets?</summary><p>Yes. Faster has Lock Screen and Home Screen widgets that keep counting without opening the app. Between fasts they count down to your next fast and fill up as your eating window passes.</p></details>
      <details><summary>Does Faster need an account or collect my data?</summary><p>No. There's no account, no analytics and no tracking. Your fasts are stored only on your iPhone and are never sent to me. See the <a href="privacy/">privacy policy</a>.</p></details>
      <details><summary>Can I fix a fast if I forgot to start or end it?</summary><p>Yes. You can move the start time of a running fast, adjust both times when you end one, and edit or delete past fasts in History. Faster can also remind you if you forget to end a fast.</p></details>
      <details><summary>Which languages is Faster available in?</summary><p>Faster is available in English, German, Spanish, French, Brazilian Portuguese and Japanese.</p></details>
      <details><summary>Who makes Faster?</summary><p>I'm Robin, and I make Faster on my own. If you like it, the optional theme purchase helps me keep working on it. Questions or ideas? Write to me at <a href="mailto:fasterfastingapp@proton.me">fasterfastingapp@proton.me</a>.</p></details>
      <p class="disclaimer">Faster is not a medical app. Talk to your doctor before you start fasting, especially if you're pregnant, have diabetes or have a history of eating disorders.</p>
    </div>
  </section>

  <section class="final">
    <div class="wrap">
      <h2>Ready for your next fast?</h2>
      <p>Free on the App Store, in six languages.</p>
      <StoreBadge />
    </div>
    <div class="fan" aria-hidden="true">
      <Shot class="phone l2" src={stats} dark={statsDark} widths={[190, 380]} sizes="clamp(110px, 15vw, 190px)" loading="lazy" />
      <Shot class="phone l1" src={night} widths={[240, 480]} sizes="clamp(140px, 19vw, 240px)" loading="lazy" />
      <Shot class="phone r1" src={fullphase} widths={[240, 480]} sizes="clamp(140px, 19vw, 240px)" loading="lazy" />
      <Shot class="phone r2" src={home} widths={[190, 380]} sizes="clamp(110px, 15vw, 190px)" loading="lazy" />
      <Shot class="phone c" src={timer} dark={timerDark} widths={[300, 620]} sizes="clamp(170px, 24vw, 300px)" loading="lazy" />
    </div>
  </section>
</main>

<Footer home />

<script>
// A hovered headline tile follows the cursor a little, and springs back to rest when it leaves.
if (matchMedia('(hover: hover) and (prefers-reduced-motion: no-preference)').matches) {
  const h1 = document.querySelector<HTMLElement>('.hero h1')!;
  for (const tile of h1.querySelectorAll<HTMLElement>('.tile')) {
    tile.addEventListener('pointermove', (e) => {
      // Offsets ignore `translate`, so this is the tile's resting spot, not where the pull has moved it.
      const box = h1.getBoundingClientRect(), size = tile.offsetWidth;
      const dx = e.clientX - (box.left + tile.offsetLeft - h1.offsetLeft + size / 2);
      const dy = e.clientY - (box.top + tile.offsetTop - h1.offsetTop + size / 2);
      tile.style.translate = `${(dx * 0.2).toFixed(1)}px ${(dy * 0.2).toFixed(1)}px`;
    });
    tile.addEventListener('pointerleave', () => { tile.style.translate = ''; });
  }
}
</script>
</Base>
