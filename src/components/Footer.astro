---
import Brand from './Brand.astro';

interface Props { home?: boolean }
const { home } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<footer>
  <div class="wrap">
    <Brand />
    <p class="tagline">A simple, private intermittent fasting timer for iPhone.</p>
    <div class="row">
      <div class="left">
        <span>© 2026 Faster</span>
        <a href="mailto:fasterfastingapp@proton.me">Support</a>
        {home ? <a href={`${base}privacy/`}>Privacy</a> : <a href={base}>Home</a>}
      </div>
      <span class="credit">Site by <a href="https://rcostudio.nz/">R&amp;Co.</a></span>
    </div>
  </div>
</footer>
