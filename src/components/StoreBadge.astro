---
import bg from '../assets/badge/badge-bg.svg?url';
import rim from '../assets/badge/badge-vector.svg?url';
import logo from '../assets/badge/badge-apple-logo.svg?url';
import word from '../assets/badge/badge-store-word.svg?url';
import smallText from '../assets/badge/badge-download-text.svg?url';
import { appStore, released } from '../release';

// Until the app is live, a plain "coming soon" label stands in for Apple's download badge,
// which would link to a page that doesn't exist yet.
interface Props { small?: boolean; label?: string; soon?: string }
const { small, label = 'Download Faster on the App Store', soon = 'Coming soon to the App Store' } = Astro.props;
---
{released ? (
  <a class:list={['store', { small }]} href={appStore} aria-label={label}>
    <span class="badge-art"><img class="bg" src={bg} alt=""><img class="rim" src={rim} alt=""><img class="logo" src={logo} alt=""><img class="word" src={word} alt=""><img class="small-text" src={smallText} alt=""></span>
  </a>
) : (
  <span class:list={['soon-badge', { small }]}><img src={logo} alt="">{soon}</span>
)}
