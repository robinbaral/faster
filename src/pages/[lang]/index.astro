---
import Home from '../../components/Home.astro';
import { locales } from '../../i18n/locales';

export function getStaticPaths() {
  return locales.filter((l) => l.code !== 'en').map((l) => ({ params: { lang: l.code } }));
}
---
<Home lang={Astro.params.lang as (typeof locales)[number]['code']} />
