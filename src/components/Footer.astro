---
import Brand from './Brand.astro';
import { strings } from '../i18n';
import { locale, locales, type LocaleCode } from '../i18n/locales';

// With `lang`, this closes the home page in that language; without, an English page like the privacy policy.
interface Props { lang?: LocaleCode }
const { lang } = Astro.props;
const t = strings[lang ?? 'en'].footer;
const base = import.meta.env.BASE_URL;
const home = `${base}${locale(lang ?? 'en').dir}`;
---
<footer>
  <div class="wrap">
    <Brand href={home} />
    <p class="tagline">{t.tagline}</p>
    <nav class="languages" aria-label={t.languages}>
      {locales.map((l) => (
        <a href={`${base}${l.dir}`} hreflang={l.hreflang} lang={l.hreflang} aria-current={l.code === lang ? 'page' : undefined}>{l.name}</a>
      ))}
    </nav>
    <div class="row">
      <div class="left">
        <span>© 2026 Faster</span>
        <a href="mailto:fasterfastingapp@proton.me">{t.support}</a>
        {lang ? <a href={`${base}privacy/`} hreflang="en">{t.privacy}</a> : <a href={home}>{t.home}</a>}
      </div>
      <span class="credit">{t.credit} <a href="https://rcostudio.nz/">R&amp;Co.</a></span>
    </div>
  </div>
</footer>
